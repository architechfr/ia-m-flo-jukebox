<?xml version="1.0" encoding="UTF-8"?>
<!-- Appli Samsung TV (Tizen) du jukebox IA-M.Flo.
     L'appli installée ne contient presque rien : elle ouvre la page TV en
     ligne (/tv/ sur Vercel). Les nouvelles chansons et les corrections
     arrivent donc sans réinstaller l'appli sur la TV. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://ia-m-flo-jukebox.vercel.app/tv" version="1.0.0" viewmodes="maximized">
  <tizen:application id="IAMFLOjbx1.Jukebox" package="IAMFLOjbx1" required_version="2.3"/>
  <content src="https://ia-m-flo-jukebox.vercel.app/tv/"/>
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>*</tizen:allow-navigation>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <icon src="icon.png"/>
  <name>IA-M.Flo</name>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:profile name="tv"/>
  <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
